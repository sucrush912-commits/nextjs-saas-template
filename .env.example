# Canonical public origin used by metadata, sitemap, OAuth callbacks and checkout URLs.
NEXT_PUBLIC_SITE_URL=
# Internal path used after login, signup, sign-out and OAuth callbacks.
NEXT_PUBLIC_POST_LOGIN_REDIRECT=
# Optional GA4 Measurement ID. Leave blank to disable GA.
NEXT_PUBLIC_GA_ID=
# Optional Vercel Web Analytics. Set to true only after reviewing your privacy policy.
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=

# Supabase project configuration. The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Waffo Pancake server credentials and default checkout currency.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_DEFAULT_CURRENCY=
# Comma-separated Waffo product IDs allowed to create checkout sessions.
# Leave blank to keep checkout disabled.
WAFFO_ALLOWED_PRODUCT_IDS=

# Retained from the original environment-variable structure. Map these to your
# product catalogue only when your business layer needs fixed product IDs.
WAFFO_PRODUCT_CREDITS_SMALL=
WAFFO_PRODUCT_CREDITS_MEDIUM=
WAFFO_PRODUCT_CREDITS_LARGE=
WAFFO_PRODUCT_MONTHLY=
WAFFO_PRODUCT_ANNUAL=

# Retained placeholders from the original location-provider integration.
# They are unused until you add your own location feature.
LOCATION_PROVIDER=
LOCATION_ALLOW_MOCK_FALLBACK=
OPEN_METEO_API_KEY=
OPEN_METEO_GEOCODING_BASE_URL=
NEXT_PUBLIC_CHECKOUT_URL=
